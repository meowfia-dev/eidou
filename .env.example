# Eidou Environment Variables Example
# Copy this file to .env and adjust values as needed.
# Note: Boolean values accept "1", "true", "0", "false".

# --- Core Configuration ---

# MCP Transport Mode
# Options: "stdio" (default), "http", "sse"
EIDOU_MCP_TRANSPORT=stdio

# MCP HTTP Port (only used if transport is http/sse)
# Default: 3100
EIDOU_MCP_PORT=3100

# Auth Secret for HTTP/SSE transport
# If set, clients must provide this as a Bearer token.
# If unset, a random token is generated on startup.
# EIDOU_AUTH_SECRET=changeme_secret_token_123

# HTTP Stateful Mode (0=false, 1=true)
# Default: 1 (true)
# Controls whether the HTTP server maintains state between requests.
EIDOU_MCP_HTTP_STATEFUL=1

# --- Resource Limits ---

# Window Pool Size
# Number of hidden windows to pre-warm for projection.
# Default: 5
EIDOU_POOL_SIZE=5

# Toast Pool Size
# Number of toast notification windows to pre-warm.
# Default: 3
EIDOU_TOAST_POOL_SIZE=3

# User Event Queue Limit
# Max pending events per window. Range: 16-16384.
# Default: 256
EIDOU_USER_EVENT_QUEUE_LIMIT=256

# --- Theming ---

# Path to a custom JSON5 theme configuration file.
# See docs/configuration.md for schema.
# Defaults to OS-standard config locations if unset.
# EIDOU_THEME_CONFIG=/path/to/my/theme.json5

# --- Tauri / Development ---

# Network host for the Vite dev server (required for external device access)
# TAURI_DEV_HOST=0.0.0.0

# --- Debug / Experimental Flags ---
# WARNING: These flags are for debugging only and may cause visual artifacts.
# They are not supported as stable APIs.

# Draw window decorations (title bar, borders)
# Default: false
# EIDOU_DEBUG_WINDOW_DECORATIONS=false

# Make windows transparent
# Default: true
# EIDOU_DEBUG_WINDOW_TRANSPARENT=true

# Allow window resizing via OS controls
# Default: false
# EIDOU_DEBUG_WINDOW_RESIZABLE=false

# Draw window shadow
# Default: false
# EIDOU_DEBUG_WINDOW_SHADOW=false

# Toast Debugging
# EIDOU_DEBUG_TOAST_SKIP_TASKBAR=true
# EIDOU_DEBUG_TOAST_ALWAYS_ON_TOP=true
# EIDOU_DEBUG_TOAST_WIDTH=320.0
# EIDOU_DEBUG_TOAST_HEIGHT=72.0
# EIDOU_DEBUG_TOAST_MARGIN_OUTER=24.0
# EIDOU_DEBUG_TOAST_SPACING=92.0
